APP_NAME=YourTeacher
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourteacher.co.in

FRONTEND_URL=https://yourteacher.co.in,https://www.yourteacher.co.in

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yourteacher
DB_USERNAME=SET_ON_SERVER
DB_PASSWORD=SET_ON_SERVER

SESSION_DRIVER=file
SESSION_DOMAIN=.yourteacher.co.in
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=yourteacher.co.in,www.yourteacher.co.in,api.yourteacher.co.in

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=SET_ON_SERVER
MAIL_PORT=587
MAIL_USERNAME=SET_ON_SERVER
MAIL_PASSWORD=SET_ON_SERVER
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourteacher.co.in
MAIL_FROM_NAME="YourTeacher"

FILESYSTEM_DISK=local
